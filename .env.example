# Example environment for the Serverless API.
# In production these are sourced from Vault via ESO
# (docs/ARCHITECTURE.md - Secrets Management); the Helm chart sets the rest as
# plain `env` on the Deployment.

# Disable auth ONLY for local development.
SERVERLESS_AUTH_ENABLED=true

# Base domain. Each region's API server is DERIVED from it and the region's cluster
# name: https://api.{cluster}.{SERVERLESS_BASE_DOMAIN}:6443 - there is no
# per-region endpoint to configure.
SERVERLESS_BASE_DOMAIN=example.com

# Platform wildcard domain - workload hosts become {name}-{group}.{ROUTE_DOMAIN}
SERVERLESS_ROUTE_DOMAIN=serverless.example.com

# Namespace (same in every cluster) where the API creates workloads.
SERVERLESS_WORKLOADS_NAMESPACE=serverless-workloads

# Available function runtimes, as a YAML file. REQUIRED - there is no built-in
# fallback, so the app refuses to start without it. In a cluster the chart
# mounts it from the runtimes ConfigMap at /etc/serverless/runtimes/runtimes.yaml
# (the default); locally, point it at the sample copy in this repo.
SERVERLESS_RUNTIMES_FILE=dev/runtimes.yaml

# Browser origins allowed to call the API (e.g. ServiceNow). Empty disables CORS.
SERVERLESS_CORS_ALLOW_ORIGINS=[]

# Static admin API key for admin automation that cannot do OIDC (from Vault via
# ESO in prod). The RAW token, sent as `Authorization: Bearer <token>` and
# matched against this value with a constant-time compare - it is not hashed, so
# whatever is set here is the credential. Empty (the default) DISABLES key auth
# rather than shipping a usable default; set it only if you need it.
SERVERLESS_ADMIN_API_KEY=

# HMAC key signing the stream tickets a browser opens an SSE endpoint with
# (EventSource cannot send an Authorization header). From Vault via ESO in prod,
# and the SAME value in every replica and region - a ticket is verified by whichever
# one the stream lands on, not by the one that minted it. Empty (the default)
# DISABLES ticket minting; the streams still take the Authorization header, so a
# curl follow works either way and only the browser path needs this set.
SERVERLESS_STREAM_TICKET_KEY=

# Bounds on the SSE endpoints (nested via __). A followed pod log holds a worker
# thread for as long as the client stays connected, so streaming gets its own
# pool and admission is capped before that pool can be exhausted.
# docs/ARCHITECTURE.md - Streaming.
SERVERLESS_STREAM__MAX_CONCURRENT=32
SERVERLESS_STREAM__INTERVAL_SECONDS=5
SERVERLESS_STREAM__MIN_INTERVAL_SECONDS=1
SERVERLESS_STREAM__MAX_INTERVAL_SECONDS=60
SERVERLESS_STREAM__HEARTBEAT_SECONDS=15
SERVERLESS_STREAM__QUEUE_SIZE=1000
# Must stay under the Route's timeout (chart: api.route.timeout), or the router
# cuts streams mid-event instead of letting them end and reconnect cleanly.
SERVERLESS_STREAM__MAX_SECONDS=3600
SERVERLESS_STREAM__TICKET_TTL_SECONDS=60

# SSO / Keycloak OIDC (nested via __). Only the issuer is configured; the
# discovery, authorize and token URLs are derived from it in-app.
SERVERLESS_SSO__ISSUER=https://sso.internal/realms/serverless
# Set to verify the token aud (needs a Keycloak audience mapper); empty skips it.
SERVERLESS_SSO__AUDIENCE=
# Public Keycloak client Swagger UI's "Authorize" uses (Auth Code + PKCE, no secret).
SERVERLESS_SSO__SWAGGER_CLIENT_ID=serverless-api-swagger
SERVERLESS_SSO__GROUPS_CLAIM=groups
SERVERLESS_SSO__ADMIN_GROUPS=["platform-admins"]

# Internal container registry (airgapped mirror). ORGANIZATION and REPOSITORY
# are the optional path segments between the host and a function's own
# {group}/{name} (docs/BUILDING.md - Registry layout); either may be empty.
SERVERLESS_REGISTRY__URL=registry.internal
SERVERLESS_REGISTRY__ORGANIZATION=
SERVERLESS_REGISTRY__REPOSITORY=serverless/builders

# Where the cert-manager client cert (tls.crt/tls.key) is mounted (global, all regions).
SERVERLESS_CLIENT_CERT_DIR=/etc/serverless/client

# Trusted CA bundle (OpenShift-injected ConfigMap), used as the k8s-client CA.
SERVERLESS_CA_BUNDLE__CONFIG_MAP=ca-bundle
SERVERLESS_CA_BUNDLE__KEY=ca-bundle.crt
SERVERLESS_CA_BUNDLE__MOUNT_PATH=/etc/ssl/certs

# Regions - JSON list (active/active). A region is a region (central/south) running a
# cluster (central-0/south-0); those two names are the whole profile, since the
# API server URL is derived (see SERVERLESS_BASE_DOMAIN) and the client cert, CA
# bundle and workloads namespace are global. Non-sensitive (ConfigMap-able).
SERVERLESS_REGIONS=[{"name":"central","cluster":"central-0"},{"name":"south","cluster":"south-0"}]

# Which region holds the kpack Images: the API writes builds only there, and the
# build controller (python -m controller.main) watches only there. Matched
# against a region name first, then a cluster name.
SERVERLESS_LOCAL_REGION=central

# Build controller only: how long each Image watch is held open, which is also
# how often it does a full relist (they are the same pass), and whether each
# pass also deletes the Images a switchover stranded in the other regions.
SERVERLESS_RESYNC_SECONDS=300
SERVERLESS_PRUNE_ORPHANS=true
