# Example environment for the Serverless API.
# In production these are sourced from Vault via ESO (see docs/ARCHITECTURE.md §7).

# Disable auth ONLY for local development.
SERVERLESS_AUTH_ENABLED=true

# Platform wildcard domain — workload hosts become {name}-{group}.{ROUTE_DOMAIN}
SERVERLESS_ROUTE_DOMAIN=serverless.example.com

# RHBK / Keycloak OIDC (nested via __)
SERVERLESS_RHBK__ISSUER=https://rhbk.internal/realms/serverless
SERVERLESS_RHBK__AUDIENCE=serverless-api
SERVERLESS_RHBK__JWKS_URL=https://rhbk.internal/realms/serverless/protocol/openid-connect/certs
SERVERLESS_RHBK__GROUPS_CLAIM=groups
SERVERLESS_RHBK__ADMIN_GROUPS=["platform-admins"]

# Internal container registry (airgapped mirror)
SERVERLESS_REGISTRY__URL=registry.internal

# Zones — JSON list of clusters to deploy to (active/active).
# client_cert_path/client_key_path come from the cert-manager Certificate secret.
SERVERLESS_ZONES=[{"name":"zone-a","api_server":"https://api.zone-a.internal:6443","ca_path":"/etc/zones/zone-a/ca.crt","client_cert_path":"/etc/zones/zone-a/tls.crt","client_key_path":"/etc/zones/zone-a/tls.key","namespace":"serverless-workloads"},{"name":"zone-b","api_server":"https://api.zone-b.internal:6443","ca_path":"/etc/zones/zone-b/ca.crt","client_cert_path":"/etc/zones/zone-b/tls.crt","client_key_path":"/etc/zones/zone-b/tls.key","namespace":"serverless-workloads"}]
