# Example environment for the Serverless API.
# In production these are sourced from Vault via ESO (see docs/ARCHITECTURE.md §7).

# Disable auth ONLY for local development.
SERVERLESS_AUTH_ENABLED=true

# Platform wildcard domain — workload hosts become {name}-{group}.{ROUTE_DOMAIN}
SERVERLESS_ROUTE_DOMAIN=serverless.example.com

# Namespace (same in every cluster) where the API creates workloads.
SERVERLESS_WORKLOADS_NAMESPACE=serverless-workloads

# Browser origins allowed to call the API (e.g. ServiceNow). Empty disables CORS.
SERVERLESS_CORS_ALLOW_ORIGINS=[]

# Static admin API key for non-OIDC service accounts (from Vault via ESO in prod).
# The RAW token, sent as `Authorization: Bearer <token>`; the API hashes it before
# a constant-time compare. Set empty to disable API-key auth. Defaults to a
# well-known dev value when unset.
SERVERLESS_ADMIN_API_KEY=Aa123456

# SSO / Keycloak OIDC (nested via __)
SERVERLESS_SSO__ISSUER=https://sso.internal/realms/serverless
SERVERLESS_SSO__AUDIENCE=serverless-api
SERVERLESS_SSO__JWKS_URL=https://sso.internal/realms/serverless/protocol/openid-connect/certs
SERVERLESS_SSO__GROUPS_CLAIM=groups
SERVERLESS_SSO__ADMIN_GROUPS=["platform-admins"]

# Internal container registry (airgapped mirror)
SERVERLESS_REGISTRY__URL=registry.internal

# Where the cert-manager client cert (tls.crt/tls.key) is mounted (global, all sites).
SERVERLESS_CLIENT_CERT_DIR=/etc/serverless/client

# Trusted CA bundle (OpenShift-injected ConfigMap), used as the k8s-client CA.
SERVERLESS_CA_BUNDLE__CONFIG_MAP=ca-bundle
SERVERLESS_CA_BUNDLE__KEY=ca-bundle.crt
SERVERLESS_CA_BUNDLE__MOUNT_PATH=/etc/ssl/certs

# Sites — JSON list (active/active). A site is a region (central/south) running a
# cluster (central-0/south-0). Client cert + CA are global. Non-sensitive (ConfigMap-able).
SERVERLESS_SITES=[{"name":"central","cluster":"central-0","api_server":"https://api.central-0.example.com:6443"},{"name":"south","cluster":"south-0","api_server":"https://api.south-0.example.com:6443"}]
